# Pontua — homologação (docker compose via WSL).
# Copie para .env (não versionado) e ajuste os valores.

# PostgreSQL
# Se trocar usuário/senha, ajuste também a connection string do appsettings.Development.json
# (que aponta para o banco pontua_dev deste mesmo container).
POSTGRES_USER=pontua
POSTGRES_PASSWORD=pontua
POSTGRES_DB=pontua
DB_PORT=5432

# API
API_PORT=5080
# Obrigatório, mínimo 32 bytes (a API não sobe sem). Gere um valor aleatório, ex.: openssl rand -base64 48
JWT_SECRET=<GERE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES>
JWT_EXPIRATION_HOURS=12
# OAuth Client ID do Google (opcional; só para login Google)
GOOGLE_CLIENT_ID=
# Link do convite e origens CORS (frontend de homologação na 8081; dev do Vite na 5173)
APP_FRONTEND_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGIN=http://localhost:8081
CORS_ALLOWED_ORIGIN_DEV=http://localhost:5173

# Frontend (pontua-frontend: nginx servindo o PWA; /api/ e /health vão para a API na mesma origem)
FRONTEND_PORT=8081
# Embutidas no bundle no build (públicas, nada de segredo). Vazio = mesma origem
VITE_API_URL=
# OAuth Client ID público do Google (opcional; vazio = botão do Google oculto)
VITE_GOOGLE_CLIENT_ID=
