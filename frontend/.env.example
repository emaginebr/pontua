# Copie para .env.local e ajuste. Apenas valores públicos — nenhum segredo no frontend (Princípio VI).

# URL base da API. Vazio = mesma origem (proxy do Vite em dev, nginx em homolog).
VITE_API_URL=

# Base path do React Router (opcional, ex.: /pontua).
VITE_SITE_BASENAME=

# OAuth Client ID público do Google (o mesmo configurado no backend).
VITE_GOOGLE_CLIENT_ID=

# Somente dev: destino do proxy de /api e /health do `npm run dev`.
VITE_DEV_API_PROXY=http://localhost:5080
